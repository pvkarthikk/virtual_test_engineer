{
  "id": "2d0f0f2b-6dcf-464e-b6d3-570e8de8f55b",
  "description": "Automated 100% Load Heating (30s) and 0% Load Cooling (75s) validation cycle based on experimental data.",
  "steps": [
    {
      "action": "write",
      "channel": "throttle",
      "value": 100.0
    },
    {
      "action": "wait",
      "duration_ms": 15000
    },
    {
      "action": "assert",
      "channel": "coolant_temp",
      "condition": ">=",
      "value": 45.0
    },
    {
      "action": "wait",
      "duration_ms": 15000
    },
    {
      "action": "assert",
      "channel": "coolant_temp",
      "condition": ">=",
      "value": 80.0
    },
    {
      "action": "write",
      "channel": "throttle",
      "value": 0.0
    },
    {
      "action": "wait",
      "duration_ms": 35000
    },
    {
      "action": "assert",
      "channel": "coolant_temp",
      "condition": "<=",
      "value": 55.0
    },
    {
      "action": "wait",
      "duration_ms": 40000
    },
    {
      "action": "assert",
      "channel": "coolant_temp",
      "condition": "<=",
      "value": 20.0
    }
  ]
}